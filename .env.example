# Muster server configuration. Copy to .env for local work.

# MongoDB. Atlas in production, a local mongod or the test harness locally.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=muster

# Public origin. Every generated URL and every agent-facing file is built from
# this, so it has to match what agents actually resolve.
BASE_URL=http://localhost:4600
PORT=4600
# Bind address. 0.0.0.0 is what a container or a dyno needs; 127.0.0.1 keeps a
# local instance off the network.
HOST=0.0.0.0

# How long an unclaimed project survives before it is deleted with its data.
DEMO_TTL_DAYS=7

# Email for the human claim step. Without a key, codes go to the log, which is
# enough for local work and for a self-host with no outbound mail.
RESEND_API_KEY=
EMAIL_FROM=Muster <onboarding@resend.dev>
CONTACT_EMAIL=

# Rate limits. A self-hosted instance behind a VPN can raise these freely; the
# published numbers in /.well-known/agent-access.json are generated from them.
LIMIT_CREATE_PROJECTS_PER_HOUR=5
LIMIT_WRITES_PER_MINUTE=120
LIMIT_READS_PER_MINUTE=600
LIMIT_CLAIM_EMAILS_PER_HOUR=5

LOG_LEVEL=info
