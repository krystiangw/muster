{
  "name": "musterboard",
  "version": "0.1.0",
  "description": "Typed client for Muster: shared operational memory for long-lived agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agents",
    "mcp",
    "coordination",
    "task",
    "memory",
    "multi-agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krystiangw/muster.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://musterboard.dev",
  "bugs": {
    "url": "https://github.com/krystiangw/muster/issues"
  }
}
